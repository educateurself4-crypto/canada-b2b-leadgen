# --- Database ---
POSTGRES_DB=leadgen
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://leadgen:changeme@postgres:5432/leadgen

# --- Scheduling ---
# Cron-style: how often to run each stage (in minutes) unless overridden per-source
COLLECT_INTERVAL_MINUTES=360
REFRESH_INTERVAL_MINUTES=1440
NEW_BUSINESS_SCAN_INTERVAL_MINUTES=60

# --- Politeness / compliance ---
# Applied to all connectors: min seconds between requests to the same host
SCRAPE_DELAY_SECONDS=2
USER_AGENT="CanadaB2BLeadGen/1.0 (contact: ops@yourcompany.example)"
RESPECT_ROBOTS_TXT=true

# --- Dashboard ---
DASHBOARD_SECRET_KEY=change-this-too
DASHBOARD_PORT=8080

# --- Optional: add API keys for provincial/municipal open-data portals here
# if any require one (most CKAN portals in Canada do not).
# ONTARIO_CKAN_BASE=https://data.ontario.ca
# TORONTO_CKAN_BASE=https://open.toronto.ca
