# --- Database ---
POSTGRES_DB=leadgen
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=CHANGE_ME_TO_A_REAL_PASSWORD
DATABASE_URL=postgresql://leadgen:CHANGE_ME_TO_A_REAL_PASSWORD@postgres:5432/leadgen

# --- Scheduling ---
# How often to run each pipeline stage (in minutes)
COLLECT_INTERVAL_MINUTES=360
REFRESH_INTERVAL_MINUTES=1440
NEW_BUSINESS_SCAN_INTERVAL_MINUTES=60

# --- Politeness / compliance ---
# Min seconds between requests to the same host (all connectors)
SCRAPE_DELAY_SECONDS=2
USER_AGENT=CanadaB2BLeadGen/1.0 (contact: your-email@yourcompany.com)
RESPECT_ROBOTS_TXT=true

# --- Dashboard ---
DASHBOARD_SECRET_KEY=CHANGE_ME_TO_A_REAL_SECRET
DASHBOARD_PORT=8080
AUTOMATION_API_KEY=CHANGE_ME_TO_A_REAL_API_KEY
DASHBOARD_INTERNAL_URL=http://dashboard:8080

# --- Optional: API keys for sources that need them ---
# Most Canadian open-data portals do NOT require API keys.
# Add keys here only if a specific source requires one.
# SOCRATA_APP_TOKEN=your_socrata_token
