{
  "id": "wf_daily_digest",
  "name": "Daily New-Leads Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "triggerAtHour": 8 }
          ]
        }
      },
      "id": "trigger",
      "name": "Every day at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://dashboard:8080/api/leads/new",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "window", "value": "today" },
            { "name": "min_quality_score", "value": "50" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "my_secure_automation_key_123" }
          ]
        }
      },
      "id": "fetch_new_leads",
      "name": "Fetch today's new leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has_leads",
              "leftValue": "={{$json.count}}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has_leads_if",
      "name": "Any new leads?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "digest",
              "name": "digest",
              "type": "string",
              "value": "=:new: *{{$json.count}} new sales-ready lead(s) today*\n{{$json.leads.map(l => `• ${l.legal_name || l.operating_name} — ${l.city}, ${l.province} — ${l.industry || 'industry unknown'} — score ${Math.round(l.quality_score)}${l.phone ? ' — ' + l.phone : ''}`).join('\\n')}}"
            }
          ]
        }
      },
      "id": "format_digest",
      "name": "Format digest message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_YOUR_SLACK_OR_TEAMS_INCOMING_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $json.digest } }}"
      },
      "id": "send_digest",
      "name": "Send digest (Slack/Teams webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 220]
    }
  ],
  "connections": {
    "Every day at 8am": { "main": [[{ "node": "Fetch today's new leads", "type": "main", "index": 0 }]] },
    "Fetch today's new leads": { "main": [[{ "node": "Any new leads?", "type": "main", "index": 0 }]] },
    "Any new leads?": { "main": [[{ "node": "Format digest message", "type": "main", "index": 0 }], []] },
    "Format digest message": { "main": [[{ "node": "Send digest (Slack/Teams webhook)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
